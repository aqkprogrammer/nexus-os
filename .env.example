# Copy this file to .env.local and fill it in. Never commit .env.local.
# Only the first block is required. Each later block switches on one feature, and the app explains
# what's missing wherever a feature isn't set up.

# --- Required ---------------------------------------------------------------

# Postgres connection, including your database username. Needs the pgvector extension.
DATABASE_URL=postgresql://USERNAME@localhost:5432/nexus_os

# Signs login sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address the app runs at. Links in emails and Stripe point here.
BETTER_AUTH_URL=http://localhost:3000

# Who can create an account: addresses, or @domain.com for everyone there, separated by commas.
# Leave it empty and only people invited to a shared space can sign up.
ALLOWED_EMAILS=

# Optional. The header your proxy sets to the visitor's real address, used to limit sign-in attempts.
# Vercel is detected automatically. Elsewhere it defaults to x-forwarded-for, which visitors can fake
# unless your proxy overwrites it.
AUTH_IP_HEADER=

# --- AI: chat, agents, goal plans, quick capture, file reading, memory search ---

OPENAI_API_KEY=
# Optional. Any Responses API model works.
OPENAI_MODEL=gpt-6-astra
# Optional. Must produce 1536-dimension vectors, the size of the memory_vector column.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Email: password reset, email confirmation, daily and weekly summaries, invitations ---

RESEND_API_KEY=
EMAIL_FROM=NEXUS OS <hello@yourdomain.com>
# Protects /api/cron/digest, which sends the summaries. Run it every hour (see vercel.json).
CRON_SECRET=

# --- Push notifications on phones and other devices ---
# Generate a pair with: npx web-push generate-vapid-keys

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# --- Google Calendar and Gmail ---
# Create an OAuth client at console.cloud.google.com. Add this redirect URI:
#   <BETTER_AUTH_URL>/api/auth/callback/google

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Billing with Stripe ---
# Without these, everyone has unlimited use and the plan card says "Early access".

STRIPE_SECRET_KEY=
# The recurring price for Pro, from your Stripe dashboard.
STRIPE_PRICE_PRO=
# From the webhook endpoint for <BETTER_AUTH_URL>/api/billing/webhook.
STRIPE_WEBHOOK_SECRET=
# Shown on the upgrade button, for example: $12 a month
PRO_PRICE_LABEL=
# AI requests per day on each plan.
FREE_AI_DAILY=30
PRO_AI_DAILY=500
